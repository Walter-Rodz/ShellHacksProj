PORT=4000
# SQLite file; created automatically on first start
DATABASE_PATH=./data/retro.db
# Comma-separated list of frontend origins allowed to call the API. "*" matches one part of a host name,
# e.g. https://yourdomain.com,https://*.vercel.app
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
GEMINI_API_KEY=change-me
GEMINI_MODEL=gemini-3.8-flash
