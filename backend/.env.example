PORT=4000
# SQLite file; created automatically on first start
DATABASE_PATH=./data/retro.db
# Comma-separated list of frontend origins allowed to call the API
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
# Folder for uploaded console photos (served at /uploads)
UPLOADS_DIR=./uploads
# Required in production. Send as the x-admin-key header to upload/delete catalog photos.
ADMIN_KEY=change-me
